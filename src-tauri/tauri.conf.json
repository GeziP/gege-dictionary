{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "鸽鸽词典",
  "version": "1.3.0",
  "identifier": "com.gege.dictionary",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "鸽鸽词典",
        "width": 1100,
        "height": 720,
        "center": true,
        "visible": true,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "shortDescription": "AI 驱动的英语词汇学习工具",
    "longDescription": "鸽鸽词典 — 复制即查，AI 解析英文单词、句子和段落。支持领域知识扩展，本地数据存储，隐私安全。",
    "copyright": "© 2026 鸽鸽词典",
    "category": "Education",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2RTA5NjhGNzc1QzQyQzcKUldUSFFseDNqNWJndHU5MGNSZkVVZzNXSTdlWnJ6VVlzMlFIVkxHSno3VnZWZGdRb0l2VXNMQ00K",
      "endpoints": [
        "https://github.com/GeziP/gege-dictionary/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
